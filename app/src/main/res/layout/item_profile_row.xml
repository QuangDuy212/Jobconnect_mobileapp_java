<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Nền tròn gradient -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/icon_circle_gradient">

        <!-- Icon trắng (hiển thị thật và preview) -->
        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="icon"
            app:srcCompat="@drawable/ic_briefcase"
            app:tint="@color/white"
            tools:srcCompat="@drawable/ic_briefcase" />
    </LinearLayout>

    <!-- Text hiển thị -->
    <TextView
        android:id="@+id/row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:text="Option"
        tools:text="Hồ sơ cá nhân" />

    <!-- Mũi tên qua phải -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="end"
        android:layout_weight="1"
        app:srcCompat="@drawable/ic_chevron_right"
        android:tint="@color/gray_dark"
        tools:srcCompat="@drawable/ic_chevron_right" />
</LinearLayout>
