<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".activity.CompanyListActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách công ty"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_centerVertical="true" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_refresh"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:contentDescription="Làm mới danh sách"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <EditText
            android:id="@+id/et_search_company"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:hint="Tìm kiếm công ty (ví dụ: FPT, Viettel...)"
            android:background="@drawable/searchbar_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:inputType="text" />
    </LinearLayout>

    <!-- Dòng lọc lĩnh vực -->
    <HorizontalScrollView
        android:id="@+id/filter_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        android:background="#F9FAFB">

        <LinearLayout
            android:id="@+id/layout_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_filter_all"
                style="@style/ChipStyle.Selected"
                android:text="Tất cả" />

            <TextView
                android:id="@+id/tv_filter_it"
                style="@style/ChipStyle"
                android:text="Công nghệ" />

            <TextView
                android:id="@+id/tv_filter_edu"
                style="@style/ChipStyle"
                android:text="Giáo dục" />

            <TextView
                android:id="@+id/tv_filter_finance"
                style="@style/ChipStyle"
                android:text="Tài chính" />

            <TextView
                android:id="@+id/tv_filter_trade"
                style="@style/ChipStyle"
                android:text="Thương mại" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Danh sách công ty -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_company_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filter_scrollview"
        android:layout_above="@id/bottom_navigation"
        android:padding="12dp"
        android:clipToPadding="false"
        android:background="#F9FAFB"
        tools:listitem="@layout/item_company_card" />

    <!-- Thanh menu dưới -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp" />

</RelativeLayout>
