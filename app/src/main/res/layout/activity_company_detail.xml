<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".activity.CompanyDetailActivity">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_buttons"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:background="@color/white"
                android:elevation="2dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Quay lại"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi tiết công ty"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true" />
            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/company_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_company_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FPT Software"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_company_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lĩnh vực: Công nghệ thông tin"
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_company_tax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã số thuế: 0101234567"
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_company_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Địa chỉ: Tòa nhà FPT, Cầu Giấy, Hà Nội"
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_company_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số điện thoại: 024-1234-5678"
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_company_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: contact@fpt.com.vn"
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_company_description_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giới thiệu:"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_company_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FPT Software là công ty phần mềm hàng đầu Việt Nam, cung cấp dịch vụ công nghệ, chuyển đổi số và giải pháp phần mềm toàn cầu."
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_company_products_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sản phẩm / Dịch vụ chính:"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_company_products"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gia công phần mềm, giải pháp ERP, AI, Cloud, IoT, dịch vụ IT outsourcing."
                        android:textSize="15sp"
                        android:textColor="#555"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"
        android:background="@color/white"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_back_to_list"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/colorSecondary"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_contact"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="Liên hệ công ty"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</RelativeLayout>
